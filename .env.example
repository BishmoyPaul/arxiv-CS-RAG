# Copy this file to `.env` for local Docker or API runs.

# Required only if the retriever must download the index from Hugging Face.
HF_TOKEN=

# Required only for real Gemini-backed answer generation.
GEMINI_API_KEY=

# Hugging Face dataset repo id containing the ColBERT index artifacts.
RAG_SOURCE=

# Optional local path for mounted index data. Defaults to `./rag_index_data`.
LOCAL_DATA_DIR=/app/rag_index_data

# Optional container port exposed by the API process.
PORT=8000
